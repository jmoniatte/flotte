#!/bin/bash
set -euo pipefail

PROJECT_PATH="${PROJECT_PATH:?PROJECT_PATH required}"
PROJECT_NAME="${PROJECT_NAME:?PROJECT_NAME required}"

PROJECT_PATH="${PROJECT_PATH/#\~/$HOME}"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LAYOUT="$SCRIPT_DIR/workspace_layout.json"

# Check if workspace exists
find_workspace() {
  i3-msg -t get_workspaces | jq -r ".[] | select(.name | endswith(\":$PROJECT_NAME\")) | .name" | head -1
}

# Find next available workspace number (11-14)
next_workspace_num() {
  local used=$(i3-msg -t get_workspaces | jq -r '.[].num' | grep -E '^1[1-4]$' || true)
  for n in 11 12 13 14; do
    if ! echo "$used" | grep -q "^$n$"; then
      echo $n
      return
    fi
  done
  echo 15
}

# Main
existing=$(find_workspace)

if [[ -n "$existing" ]]; then
  i3-msg "workspace $existing"
else
  num=$(next_workspace_num)
  i3-msg "workspace $num:$PROJECT_NAME"
  i3-msg "append_layout $LAYOUT"

  alacritty --class Alacritty,ride_claude --working-directory "$PROJECT_PATH" -e bash -lic 'claude --dangerously-skip-permissions; exec bash' &
  alacritty --class Alacritty,ride_editor --working-directory "$PROJECT_PATH" -e bash -lic 'nvim; exec bash' &
  alacritty --class Alacritty,ride_logs --working-directory "$PROJECT_PATH" -e bash -lic 'trap "" INT; ./ride.rb logs; exec bash' &
fi
