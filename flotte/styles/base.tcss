/* ═══════════════════════════════════════════════════════════════════════
   BASE STYLES - Layout and structure (colors come from theme)
   ═══════════════════════════════════════════════════════════════════════ */

/* ═══════════════════════════════════════════════════════════════════════
   GLOBAL LAYOUT
   ═══════════════════════════════════════════════════════════════════════ */

Screen {
    background: $bg;
    color: $fg;
    border: solid $gutter;
}

ModalScreen {
    border: none;
}

/* Custom app header with project selector */
#app-header {
    dock: top;
    height: auto;
    background: $bg;
    padding: 0 1;
    border-bottom: solid $gutter;
    margin: 0 0 1 0;
}

#app-title-group {
    width: auto;
    height: auto;
}

#header-spacer {
    width: 1fr;
}

.header-notification-spacer {
    width: 1fr;
}

#app-title {
    width: auto;
    text-style: bold;
    color: $blue;
    background: transparent;
}

#app-title:hover {
    color: $blue;
    text-style: bold underline;
    background: transparent;
}

#app-subtitle {
    width: auto;
    color: $comment;
}

HeaderNotification {
    width: 40%;
    height: auto;
    max-height: 2;
    padding: 0 1;
}

HeaderNotification.-information {
    color: $green;
}

HeaderNotification.-warning {
    color: $yellow;
}

HeaderNotification.-error {
    color: $red;
}

#project-selector {
    width: 25;
    background: transparent;
    border: none;
    padding: 0;
}

#project-selector SelectCurrent {
    background: transparent;
    border: none;
    border-bottom: solid $gutter;
    padding: 0;
    color: $comment;
}

#project-selector SelectCurrent:hover {
    border-bottom: solid $blue;
}

#project-selector SelectCurrent.-has-value Static#label,
#project-selector SelectCurrent .arrow {
    color: $comment;
}

#project-selector SelectOverlay {
    background: $bg-dark;
    border: none;
    padding: 0;
    margin: 0;
}

#project-selector SelectOverlay > .option-list--option {
    padding: 0 1;
}

#project-selector SelectOverlay > .option-list--option-highlighted {
    background: $bg-light;
}

#project-name {
    width: 25;
    content-align: left middle;
    color: $comment;
}

#no-projects-label {
    color: $red;
}

#project-problems {
    height: auto;
    margin: 1 1;
    padding: 0 1;
    color: $red;
    border-left: solid $red;
}

/* ═══════════════════════════════════════════════════════════════════════
   WORKTREES BOX
   ═══════════════════════════════════════════════════════════════════════ */

#worktrees-box {
    height: auto;
    padding: 1 1 0 1;
    margin: 0 1;
}

#worktrees-title {
    height: auto;
    margin: 0 1;
    padding: 0 1;
    color: $yellow;
    text-style: bold;
}

#list-view {
    height: auto;
}

WorktreeHeader {
    height: auto;
}

WorktreeHeader #worktree-table {
    height: auto;
    background: transparent;
    border: none;
    color: $fg;
    scrollbar-size: 0 0;
}

WorktreeHeader #worktree-table > .datatable--header {
    background: transparent;
    color: $comment;
}

WorktreeHeader #worktree-table > .datatable--header-hover {
    background: transparent;
    color: $comment;
}

WorktreeHeader #worktree-table > .datatable--cursor {
    background: $bg-light;
    color: auto;
    text-style: none;
}

WorktreeHeader #worktree-table > .datatable--hover {
    background: transparent;
}

WorktreeHeader #worktree-table-footer-rule {
    height: 1;
    color: $comment;
}

#worktree-controls {
    height: 1;
    padding: 0 1;
    margin: 0 1 1 1;
    background: transparent;
}

#worktree-controls Button {
    margin: 0 1 0 0;
    width: auto;
    min-width: 0;
    border: none;
    padding: 0 2;
}

#btn-new-worktree {
    background: $blue 30%;
    color: $blue;
}

#btn-new-worktree:hover {
    background: $blue 50%;
}

#btn-new-worktree:focus {
    background: $blue;
    color: $bg-dark;
    text-style: bold;
}

#btn-refresh {
    background: $purple 30%;
    color: $purple;
}

#btn-refresh:hover {
    background: $purple 50%;
}

#btn-refresh:focus {
    background: $purple;
    color: $bg-dark;
    text-style: bold;
}

#worktree-controls .spacer {
    width: 1fr;
}

#btn-help {
    background: $comment 30%;
    color: $comment;
}

#btn-help:hover {
    background: $comment 50%;
}

#btn-help:focus {
    background: $fg;
    color: $bg-dark;
    text-style: bold;
}

/* ═══════════════════════════════════════════════════════════════════════
   CONTAINERS BOX
   ═══════════════════════════════════════════════════════════════════════ */

#containers-box {
    height: auto;
    padding: 0;
    margin: 1 1;
}

#breadcrumbs {
    height: auto;
    margin: 0 1;
    padding: 0;
}

#breadcrumb-worktrees {
    width: auto;
    margin-left: 1;
    color: $blue;
}

#breadcrumb-worktrees:hover {
    color: $blue;
    text-style: underline;
}

#breadcrumb-separator {
    width: auto;
    margin: 0 1;
    color: $comment;
}

#breadcrumb-worktree {
    width: auto;
    color: $yellow;
    text-style: bold;
}

#breadcrumb-git-status {
    width: auto;
    margin-left: 1;
}

#breadcrumbs .spacer {
    width: 1fr;
}

#breadcrumbs #btn-ride {
    width: auto;
    min-width: 0;
    margin: 0;
    padding: 0 2;
    border: none;
    background: $cyan 30%;
    color: $cyan;
}

#breadcrumbs #btn-ride:hover {
    background: $cyan 50%;
}

#breadcrumbs #btn-ride:focus {
    background: $cyan;
    color: $bg-dark;
    text-style: bold;
}

#breadcrumbs #btn-logs {
    width: auto;
    min-width: 0;
    margin: 0 1 0 0;
    padding: 0 2;
    border: none;
    background: $bg-light;
    color: $fg;
}

#breadcrumbs #btn-logs:hover {
    background: $gutter;
}

#breadcrumbs #btn-logs:focus {
    background: $blue;
    color: $bg-dark;
    text-style: bold;
}

WebLink {
    width: auto;
    color: $blue;
    text-style: none;
    background: transparent;
}

WebLink:hover {
    color: $blue;
    text-style: underline;
    background: transparent;
}

/* ═══════════════════════════════════════════════════════════════════════
   MAIN CONTENT AREA
   ═══════════════════════════════════════════════════════════════════════ */

#view-switcher {
    width: 100%;
    height: 1fr;
    background: $bg;
    overflow-y: auto;
}

#details-view {
    height: 100%;
}

/* ═══════════════════════════════════════════════════════════════════════
   CONTAINER CONTROLS
   ═══════════════════════════════════════════════════════════════════════ */

ContainerControls {
    height: auto;
    padding: 0 2 1 1;
    align: left top;
    background: transparent;
}

ContainerControls Button {
    margin: 0 1 0 0;
    padding: 0;
    background: $bg-light;
    color: $fg;
    border: none;
}

ContainerControls Button:hover {
    background: $gutter;
}

ContainerControls Button:focus {
    background: $blue;
    color: $bg-dark;
    text-style: bold;
}

ContainerControls #btn-container-start {
    background: $green 30%;
    color: $green;
}

ContainerControls #btn-container-start:hover {
    background: $green 50%;
}

ContainerControls #btn-container-start:focus {
    background: $green 30%;
    color: $green;
    text-style: bold;
}

ContainerControls #btn-container-stop {
    background: $red 30%;
    color: $red;
}

ContainerControls #btn-container-stop:hover {
    background: $red 50%;
}

ContainerControls #btn-container-stop:focus {
    background: $red;
    color: $bg-dark;
    text-style: bold;
}

ContainerControls #btn-container-restart {
    background: $yellow 30%;
    color: $yellow;
}

ContainerControls #btn-container-start,
ContainerControls #btn-container-stop,
ContainerControls #btn-container-restart,
.linked-repository-lifecycle Button {
    width: auto;
    min-width: 0;
    padding: 0 2;
    text-align: left;
}

ContainerControls #btn-container-restart:hover {
    background: $yellow 50%;
}

ContainerControls #btn-container-restart:focus {
    background: $yellow;
    color: $bg-dark;
    text-style: bold;
}

ContainerControls #container-url {
    margin: 0 1 0 0;
}

ContainerControls .spacer {
    width: 1fr;
}

/* ═══════════════════════════════════════════════════════════════════════
   CONTAINER TABLE
   ═══════════════════════════════════════════════════════════════════════ */

ContainerTable {
    height: auto;
    background: transparent;
    color: $fg;
    border: none;
    margin: 0 1;
    scrollbar-size: 0 0;
}

ContainerTable > .datatable--header {
    background: transparent;
    color: $comment;
    text-style: none;
}

ContainerTable > .datatable--header-hover {
    background: transparent;
    color: $comment;
    text-style: none;
}

ContainerTable > .datatable--hover {
    background: transparent;
}

#container-table-footer-rule {
    height: 1;
    margin: 0 1;
    color: $comment;
}

#container-loading {
    height: 1;
    margin: 0 1;
    color: $comment;
}

ContainerControls #btn-delete-worktree {
    width: auto;
    min-width: 0;
    margin: 0;
    padding: 0 2;
    border: none;
    background: $red 30%;
    color: $red;
}

ContainerControls #btn-delete-worktree:hover {
    background: $red 50%;
}

ContainerControls #btn-delete-worktree:focus {
    background: $red;
    color: $bg-dark;
    text-style: bold;
}

/* ═══════════════════════════════════════════════════════════════════════
   SCROLLBARS (global)
   ═══════════════════════════════════════════════════════════════════════ */

* {
    scrollbar-size: 0 0;
    scrollbar-background: $bg;
    scrollbar-color: $gutter;
    scrollbar-color-hover: $comment;
    scrollbar-color-active: $blue;
}

/* ═══════════════════════════════════════════════════════════════════════
   MODAL SCREENS
   ═══════════════════════════════════════════════════════════════════════ */

ModalScreen {
    align: center top;
    background: $bg 80%;
}

ModalScreen > Vertical {
    width: 60;
    height: auto;
    max-height: 80%;
    background: $bg-dark;
    border: none;
    padding: 1 2;
    margin-top: 4;
}

ModalScreen #dialog-title,
#no-config-dialog #dialog-title {
    border-bottom: ascii $gutter;
}

ModalScreen Input {
    width: 100%;
    margin: 1 0;
    background: $bg;
    color: $fg;
    border: solid $gutter;
}

ModalScreen Input:focus {
    border: solid $blue;
}

ModalScreen Button {
    width: auto;
    min-width: 0;
    margin: 1 1 0 0;
    padding: 0 2;
    background: $bg-light;
    color: $fg;
}

ModalScreen Button:focus {
    background: $blue;
    color: $bg-dark;
}

/* ═══════════════════════════════════════════════════════════════════════
   HELP SCREEN
   ═══════════════════════════════════════════════════════════════════════ */

HelpScreen {
    align: center top;
    background: $bg 80%;
}

HelpScreen > Vertical {
    width: auto;
    min-width: 64;
    max-width: 70;
    height: auto;
    max-height: 80%;
    background: $bg-dark;
    border: none;
    padding: 1 2;
}

HelpScreen Static {
    color: $fg;
}

HelpScreen #dialog-title {
    text-style: bold;
    color: $blue;
}

HelpScreen #title-separator {
    height: 1;
}

HelpScreen .section-title {
    text-style: bold;
    color: $fg;
    border-bottom: ascii $gutter;
}

HelpScreen #help-sections {
    height: 9;
}

HelpScreen .help-section {
    height: 9;
}

HelpScreen #help-actions {
    width: 30;
    margin-right: 3;
}

HelpScreen #help-general {
    width: 27;
}

HelpScreen #help-sections-separator {
    height: 1;
    color: $comment;
}

HelpScreen .shortcut-row {
    height: 1;
}

HelpScreen .shortcut-key {
    width: 8;
    color: $green;
}

HelpScreen .shortcut-desc {
    color: $fg;
}

HelpScreen #help-footer {
    height: 1;
    align: right middle;
}

HelpScreen #help-footer-spacer {
    height: 1;
}

HelpScreen #help-footer .spacer {
    width: 1fr;
}

HelpScreen #help-version {
    width: auto;
    margin-left: 1;
    color: $comment;
}

HelpScreen #help-repository {
    width: auto;
    color: $blue;
    background: transparent;
}

HelpScreen #help-repository:hover {
    color: $blue;
    text-style: underline;
    background: transparent;
}

WorktreeLogScreen,
LinkedProcessLogScreen {
    background: $bg;
}

#worktree-log-screen {
    height: 1fr;
    padding: 0 2 1 2;
}

#log-breadcrumbs {
    height: 1;
    margin-bottom: 1;
}

#log-breadcrumb-worktrees,
#log-breadcrumb-worktree {
    width: auto;
    color: $blue;
}

#log-breadcrumb-worktrees:hover,
#log-breadcrumb-worktree:hover {
    text-style: underline;
}

.log-breadcrumb-separator {
    width: auto;
    margin: 0 1;
    color: $comment;
}

#log-breadcrumb-current {
    width: auto;
    color: $yellow;
    text-style: bold;
}

#worktree-log {
    height: 1fr;
    background: transparent;
    color: $fg;
    border: none;
    padding: 0;
    scrollbar-size: 0 0;
}

#worktree-log-header {
    height: 1;
    color: $comment;
}

#worktree-log-datetime {
    width: 22;
}

#worktree-log-label {
    width: 1fr;
}

#worktree-log-rule {
    height: 1;
    color: $comment;
}

/* ═══════════════════════════════════════════════════════════════════════
   CONFIRM DIALOG
   ═══════════════════════════════════════════════════════════════════════ */

ConfirmDialog > Vertical {
    width: auto;
    min-width: 40;
    max-width: 60;
    background: $bg-dark;
    border: none;
    padding: 1 2;
}

ConfirmDialog #dialog-title {
    text-style: bold;
    color: $red;
    margin-bottom: 1;
}

ConfirmDialog #dialog-message {
    color: $fg;
}

ConfirmDialog #dialog-buttons {
    height: 1;
    align: right middle;
    margin-top: 1;
}

ConfirmDialog Button {
    width: auto;
    min-width: 0;
    border: none;
    margin: 0 0 0 1;
    padding: 0 2;
}

ConfirmDialog #cancel-btn {
    background: $bg-light;
    color: $fg;
}

ConfirmDialog #cancel-btn:hover {
    background: $gutter;
}

ConfirmDialog #cancel-btn:focus {
    background: $blue;
    color: $bg-dark;
    text-style: bold;
}

ConfirmDialog #confirm-btn {
    background: $red 30%;
    color: $red;
}

ConfirmDialog #confirm-btn:hover {
    background: $red 50%;
}

ConfirmDialog #confirm-btn:focus {
    background: $red;
    color: white;
    text-style: bold;
}

/* ═══════════════════════════════════════════════════════════════════════
   CREATE WORKTREE SCREEN
   ═══════════════════════════════════════════════════════════════════════ */

CreateWorktreeScreen > Vertical {
    width: auto;
    min-width: 45;
    max-width: 60;
    background: $bg-dark;
    border: none;
    padding: 1 2;
}

CreateWorktreeScreen #dialog-title {
    text-style: bold;
    color: $blue;
    margin-bottom: 1;
}

/* TabbedContent for branch mode selection */
CreateWorktreeScreen #branch-mode {
    height: auto;
    margin: 0;
}

CreateWorktreeScreen #branch-mode Tabs {
    height: 1;
    background: transparent;
    margin-bottom: 1;
}

CreateWorktreeScreen #branch-mode Tab {
    background: transparent;
    color: $comment;
    padding: 0 1;
}

CreateWorktreeScreen #branch-mode Tab.-active {
    color: $blue;
    text-style: bold;
}

CreateWorktreeScreen #branch-mode Tab:hover {
    color: $fg;
}

CreateWorktreeScreen #branch-mode Underline {
    background: transparent;
}

CreateWorktreeScreen #branch-mode TabPane {
    height: auto;
    padding: 0;
}

CreateWorktreeScreen .field-label {
    color: $comment;
    margin-top: 0;
}

CreateWorktreeScreen .form-row {
    height: 2;
    align: left middle;
    margin-bottom: 1;
}

CreateWorktreeScreen .form-row .field-label {
    width: 14;
    margin: 0;
}

CreateWorktreeScreen Input {
    width: 1fr;
    height: 2;
    margin: 0 0 1 0;
    padding: 0;
    background: transparent;
    border: none !important;
    border-bottom: solid $gutter !important;
}

CreateWorktreeScreen Input:hover {
    border-bottom: solid $blue !important;
}

CreateWorktreeScreen Input:focus {
    border: none !important;
    border-bottom: solid $gutter !important;
    background: transparent;
}

/* Select - clean style */
CreateWorktreeScreen Select {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    background: transparent;
    border: none;
    padding: 0;
}

CreateWorktreeScreen SelectCurrent {
    background: transparent;
    border: none;
    border-bottom: solid $gutter;
    padding: 0;
}

CreateWorktreeScreen SelectCurrent:hover {
    border-bottom: solid $blue;
}

CreateWorktreeScreen SelectOverlay {
    background: $bg-dark;
    border: none;
    padding: 0;
    margin: 0;
}

CreateWorktreeScreen SelectOverlay > .option-list--option {
    padding: 0 1;
}

CreateWorktreeScreen SelectOverlay > .option-list--option-highlighted {
    background: $bg-light;
}

/* Checkboxes */
CreateWorktreeScreen Checkbox {
    height: auto;
    padding: 0;
    margin: 0 0 0 0;
    background: transparent;
    border: none;
}

CreateWorktreeScreen #dialog-buttons {
    height: 1;
    align: right middle;
    margin-top: 1;
}

CreateWorktreeScreen Button {
    width: auto;
    min-width: 0;
    border: none;
    margin: 0 0 0 1;
    padding: 0 2;
}

CreateWorktreeScreen #cancel-btn {
    background: $bg-light;
    color: $fg;
}

CreateWorktreeScreen #cancel-btn:hover {
    background: $gutter;
}

CreateWorktreeScreen #cancel-btn:focus {
    background: $blue;
    color: $bg-dark;
    text-style: bold;
}

CreateWorktreeScreen #create-btn {
    background: $green 30%;
    color: $green;
}

CreateWorktreeScreen #create-btn:hover {
    background: $green 50%;
}

CreateWorktreeScreen #create-btn:focus {
    background: $green;
    color: $bg-dark;
    text-style: bold;
}

/* Status area during creation */
CreateWorktreeScreen #status-area {
    height: auto;
    align: center middle;
    padding: 2 0;
}

CreateWorktreeScreen #loading-icon {
    width: auto;
    padding-right: 1;
    color: $blue;
}

CreateWorktreeScreen #status-text {
    color: $blue;
}

/* ═══════════════════════════════════════════════════════════════════════
   DELETE WORKTREE SCREEN
   ═══════════════════════════════════════════════════════════════════════ */

DeleteWorktreeScreen #delete-dialog {
    width: auto;
    min-width: 45;
    max-width: 60;
    background: $bg-dark;
    border: none;
    padding: 1 2;
}

DeleteWorktreeScreen #dialog-title {
    text-style: bold;
    color: $red;
    margin-bottom: 1;
}

DeleteWorktreeScreen #confirm-content {
    height: auto;
    padding: 0;
}

DeleteWorktreeScreen #confirm-message {
    color: $fg;
}

DeleteWorktreeScreen #confirm-warning {
    color: $comment;
    margin-top: 1;
}

DeleteWorktreeScreen #dialog-buttons {
    height: 1;
    align: right middle;
    margin-top: 1;
}

DeleteWorktreeScreen Button {
    width: auto;
    min-width: 0;
    border: none;
    margin: 0 0 0 1;
    padding: 0 2;
}

DeleteWorktreeScreen #cancel-btn {
    background: $bg-light;
    color: $fg;
}

DeleteWorktreeScreen #cancel-btn:hover {
    background: $gutter;
}

DeleteWorktreeScreen #cancel-btn:focus {
    background: $blue;
    color: $bg-dark;
    text-style: bold;
}

DeleteWorktreeScreen #delete-btn {
    background: $red 30%;
    color: $red;
}

DeleteWorktreeScreen #delete-btn:hover {
    background: $red 50%;
}

DeleteWorktreeScreen #delete-btn:focus {
    background: $red;
    color: white;
    text-style: bold;
}

/* Status area during deletion */
DeleteWorktreeScreen #status-area {
    height: auto;
    align: center middle;
    padding: 2 0;
}

DeleteWorktreeScreen #loading-icon {
    width: auto;
    padding-right: 1;
    color: $red;
}

DeleteWorktreeScreen #status-text {
    color: $red;
}

LinkedRepositories {
    height: auto;
    padding: 0 1 1 1;
    color: $comment;
}

.linked-repository-row {
    height: auto;
}

.linked-repository-separator {
    height: 1;
    width: 100%;
    border-top: solid $gutter 30%;
}

.linked-repository-title {
    width: auto;
    color: $yellow;
    text-style: bold;
}

.linked-repository-heading {
    height: 1;
    margin-bottom: 1;
}

.linked-repository-git-status {
    width: auto;
    margin-left: 1;
}

.linked-repository-details {
    height: 1;
    margin-left: 0;
}

.linked-repository-url {
    width: auto;
    color: $blue;
    text-style: none;
    background: transparent;
}

.linked-repository-url:hover {
    color: $blue;
    text-style: underline;
    background: transparent;
}

.linked-repository-details .spacer {
    width: 1fr;
}

.linked-repository-lifecycle {
    width: 37;
}

.linked-repository-lifecycle Button {
    margin: 0 1 0 0;
    border: none;
    background: $purple 30%;
    color: $purple;
}

.linked-repository-lifecycle Button:hover {
    background: $purple 50%;
}

.linked-repository-lifecycle Button:focus {
    background: $purple;
    color: $bg-dark;
    text-style: bold;
}

.linked-repository-lifecycle .linked-start-button {
    background: $green 30%;
    color: $green;
}

.linked-repository-lifecycle .linked-start-button:hover {
    background: $green 50%;
}

.linked-repository-lifecycle .linked-start-button:focus {
    background: $green 30%;
    color: $green;
    text-style: bold;
}

.linked-repository-lifecycle .linked-stop-button,
.linked-unlink-button {
    background: $red 30%;
    color: $red;
}

.linked-repository-lifecycle .linked-stop-button:hover {
    background: $red 50%;
}

.linked-repository-lifecycle .linked-stop-button:focus {
    background: $red;
    color: $bg-dark;
    text-style: bold;
}

.linked-repository-lifecycle .linked-restart-button {
    background: $yellow 30%;
    color: $yellow;
}

.linked-repository-lifecycle .linked-restart-button:hover {
    background: $yellow 50%;
}

.linked-repository-lifecycle .linked-restart-button:focus {
    background: $yellow;
    color: $bg-dark;
    text-style: bold;
}

.linked-logs-button {
    width: auto;
    min-width: 0;
    margin: 0 1 0 0;
    padding: 0 2;
    border: none;
    background: $bg-light;
    color: $fg;
}

.linked-logs-button:hover {
    background: $gutter;
}

.linked-logs-button:focus {
    background: $blue;
    color: $bg-dark;
    text-style: bold;
}

.linked-unlink-button {
    width: auto;
    min-width: 0;
    margin: 0 1 0 0;
    padding: 0 2;
    border: none;
}

.linked-unlink-button:hover {
    background: $red 50%;
}

.linked-unlink-button:focus {
    background: $red;
    color: $bg-dark;
    text-style: bold;
}

/* ═══════════════════════════════════════════════════════════════════════
   TOAST NOTIFICATIONS
   ═══════════════════════════════════════════════════════════════════════ */

ToastRack {
    dock: bottom;
    align-horizontal: right;
    margin-top: 0;
}

Toast {
    padding: 0 1;
    margin: 0 1 1 0;
    width: auto;
}

Toast.-information {
    background: $green;
    color: $bg-dark;
}

Toast.-warning {
    background: $yellow;
    color: $bg-dark;
}

Toast.-error {
    background: $red;
    color: white;
}

/* ═══════════════════════════════════════════════════════════════════════
   NO CONFIG DIALOG (shown when no projects configured)
   ═══════════════════════════════════════════════════════════════════════ */

#no-config-center {
    width: 100%;
    height: 100%;
    align: center top;
}

#no-config-dialog {
    width: auto;
    height: auto;
    min-width: 55;
    max-width: 70;
    background: $bg-dark;
    border: none;
    padding: 1 2;
    margin-top: 4;
}

#no-config-dialog #dialog-title {
    text-style: bold;
    color: $yellow;
    margin-bottom: 1;
}

#no-config-content {
    height: auto;
    padding: 0;
}

#no-config-message {
    color: $fg;
}

#no-config-path {
    color: $comment;
    margin-top: 1;
}

#no-config-help {
    color: $comment;
    margin-top: 1;
}

#no-config-dialog #dialog-buttons {
    height: 1;
    align: center middle;
    margin-top: 1;
}

#no-config-dialog Button {
    width: auto;
    min-width: 0;
    border: none;
    margin: 0 0 0 1;
    padding: 0 2;
}

#no-config-dialog #quit-btn {
    background: $red 30%;
    color: $red;
}

#no-config-dialog #quit-btn:hover {
    background: $red 50%;
}

#no-config-dialog #quit-btn:focus {
    background: $red;
    color: white;
    text-style: bold;
}

/* Disabled controls are neutral and never adopt an action hover/focus color. */
Button:disabled {
    background: $comment 30%;
    color: $comment;
    text-style: none;
}

/* These selectors override the more-specific action hover and focus rules above. */
#btn-new-worktree:disabled,
#btn-refresh:disabled,
#btn-help:disabled,
ContainerControls #btn-container-start:disabled,
ContainerControls #btn-container-stop:disabled,
ContainerControls #btn-container-restart:disabled,
#breadcrumbs #btn-ride:disabled,
#breadcrumbs #btn-logs:disabled,
ContainerControls #btn-delete-worktree:disabled,
.linked-repository-lifecycle Button:disabled,
.linked-repository-lifecycle .linked-start-button:disabled,
.linked-repository-lifecycle .linked-stop-button:disabled,
.linked-repository-lifecycle .linked-restart-button:disabled,
.linked-unlink-button:disabled,
ModalScreen #cancel-btn:disabled,
ModalScreen #confirm-btn:disabled,
ModalScreen #create-btn:disabled,
ModalScreen #delete-btn:disabled,
#no-config-dialog #quit-btn:disabled {
    background: $comment 30%;
    color: $comment;
    text-style: none;
}
